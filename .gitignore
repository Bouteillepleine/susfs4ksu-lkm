# kernel module build outputs
*.o
*.ko
*.mod
*.mod.c
*.mod.o
*.order
.modules.order
Module.symvers
modules.order
*.cmd
.tmp_versions/

# downloaded CI artifacts
artifacts/
art*/

# device panic logs (debug artifacts, contain device info)
last_kmsg*.gz
last_kmsg*.txt
kmsg.dat.gz

# temporary device test scripts (hardcode /data/local/tmp paths)
test_*.sh

# local ABI-layout verification scaffolding (uses stub <linux/*> shims)
abi_layout_check/

# device test scripts (t_*.sh): they hardcode /data/local/tmp paths and are
# hardware-specific scaffolding, not part of the module.  Earlier revisions
# tracked them; this keeps new ones out.  (tools/ is NOT ignored - CI builds
# tools/susfs_sc.c into the supercall client.)
t_*.sh
art/

# Documents that are not needed to build or use the module are kept out of the tree:
# only README.md, PROC_INTERFACES.md and this branch's LEGACY_PORTING.md are published.
*.md
!README.md
!PROC_INTERFACES.md
# The legacy branch's porting map ships with that branch, for whoever ports this to a
# pre-5.10 kernel: it is written at the API level (which release moved which interface).
!LEGACY_PORTING.md

# development-only scaffolding: the probe/test modules and C test programs used
# while working the hooks out.  They are not built by kernel/Makefile and are not
# part of the module; only tools/susfs_sc.c is, because CI compiles it.
diag_or.sh
test_*.c
kernel/*_test.c
kernel/*_test*.c
kernel/*_probe_main.c
kernel/ih_hook_main.c
kernel/ih_hook_stub.S

# namespace-probe helper used by t_clonens.sh
nsprobe.sh

# local scratch: downloaded CI artifacts, device scripts and CI logs used while verifying
dist/
